# API Configuration
VITE_API_URL=http://localhost:3000/api

# Optional: Set to 'true' to enable debug mode
VITE_DEBUG=false

# HttpOnly-cookie auth (XSS hardening): the session lives in HttpOnly cookies
# set by the API instead of tokens in localStorage. Leave EMPTY: the panel
# switches it on by itself when it runs on the same site as the API
# (admin.example.pk + api.example.pk) and keeps bearer tokens elsewhere
# (localhost, a *.vercel.app preview). true / false forces it.
VITE_AUTH_COOKIES=
